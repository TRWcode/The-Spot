# Contactformulier — kopieer dit bestand naar .env.local en vul in.
#
# Zonder RESEND_API_KEY en CONTACT_FROM weigert het formulier bewust te
# versturen en krijgt de bezoeker het e-mailadres te zien. Beter dan een
# formulier dat doet alsof het gelukt is en het bericht weggooit.
#
# DE OPZET, KORT: in Resend hoeft alleen het AFZENDERdomein geverifieerd te
# zijn — stapit.com. De ONTVANGER mag elk adres ter wereld zijn en hoeft
# nergens voor aangemeld. Eén geverifieerd domein bedient dus alle klantsites;
# per klant verandert alleen het adres voor de @ en de ontvanger.

# 1. API-sleutel: resend.com -> API Keys -> Create API Key (Sending access).
#    Maak er één per klantproject, dan kun je er één intrekken zonder de
#    andere sites om te trekken.
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxx

# 2. Afzender. Het domein moet in Resend op "Verified" staan; het deel voor
#    de @ verzin je zelf en hoeft geen bestaande mailbox te zijn. Per klant
#    een eigen adres houdt de Resend-logs uit elkaar. Wat de ontvanger in
#    z'n inbox ziet staan is de weergavenaam ("The SPOT"), niet het adres.
CONTACT_FROM="The SPOT <thespot@stapit.com>"

# 3. Ontvanger — optioneel. Leeg laten pakt site.email uit lib/content.ts,
#    wat voor deze site al klopt. Zet 'm alleen als de mail ergens anders
#    heen moet dan het adres dat op de site staat.
# CONTACT_TO=beer@dikkeboomspotproducties.nl

# Reply-To is altijd de invuller van het formulier, dus je kunt direct op de
# binnengekomen mail antwoorden en je mailt met de lead zelf.

# Contactformulier — kopieer dit bestand naar .env.local en vul in.
#
# Zonder deze twee variabelen weigert het formulier bewust te versturen en
# krijgt de bezoeker het e-mailadres te zien. Beter dan een formulier dat
# doet alsof het gelukt is en het bericht weggooit.

# 1. API-sleutel van resend.com (gratis tot 3.000 mails per maand)
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxx

# 2. Afzender. Het domein hierin moet geverifieerd zijn in Resend, anders
#    weigert de API de mail. Berichten komen binnen op het adres in
#    lib/content.ts (site.email) en Reply-To is de invuller, dus je kunt
#    direct op de mail antwoorden.
CONTACT_FROM="The SPOT <formulier@dikkeboomspotproducties.nl>"
